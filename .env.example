# Copy to .env in the repository root. Optional provider values stay blank in Phase 1.
APP_NAME=VocaLead AI
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=false
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Explicit SQLite fallback; relative paths resolve from the repository root.
# For PostgreSQL: postgresql+psycopg://vocalead:<password>@localhost:5432/vocalead
DATABASE_URL=sqlite:///./data/vocalead.db
LOG_LEVEL=INFO
# Required only for Docker PostgreSQL. Choose your own local password.
POSTGRES_USER=vocalead
POSTGRES_DB=vocalead
POSTGRES_PASSWORD=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=vocalead-sales-agent
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=
DEEPGRAM_STT_LANGUAGE=multi
GOOGLE_API_KEY=
GEMINI_MODEL=
GEMINI_EMBEDDING_MODEL=
EMBEDDING_PROVIDER=gemini
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_COLLECTION_NAME=vocalead_knowledge
RAG_TOP_K=5
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_MAX_CONTEXT_CHARS=6000
RAG_MAX_COSINE_DISTANCE=0.6
TTS_PROVIDER=
TTS_API_KEY=
TTS_MODEL=
TTS_VOICE_ID=
VOICE_DEFAULT_LANGUAGE=en
VOICE_MAX_SESSION_SECONDS=600
VOICE_TOKEN_TTL_SECONDS=300
VOICE_TRANSCRIPT_RETENTION_ENABLED=false
CHROMA_PERSIST_DIRECTORY=./data/chroma
GOOGLE_CALENDAR_ID=
GOOGLE_APPLICATION_CREDENTIALS=
HUBSPOT_ACCESS_TOKEN=
CALENDAR_PROVIDER=local
CRM_PROVIDER=local
APPOINTMENT_TIMEZONE=Asia/Kolkata
APPOINTMENT_DURATION_MINUTES=30
APPOINTMENT_BOOKING_HORIZON_DAYS=14
APPOINTMENT_MIN_NOTICE_MINUTES=120
BOOKING_PROPOSAL_TTL_SECONDS=300
